<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Slovo.App.ViewModels"
             xmlns:loc="using:Slovo.App.Localization"
             x:Class="Slovo.App.Views.ConfirmSheetView"
             x:DataType="vm:ConfirmSheetViewModel">
  <StackPanel Spacing="12" Width="400">
    <TextBlock Classes="SectionTitle" Text="{Binding Title}" TextWrapping="Wrap" />
    <TextBlock Classes="Secondary" Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Classes="Secondary" Content="{loc:T common.cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Classes="Destructive" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsVisible="{Binding IsDestructive}" />
      <Button Classes="Primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsVisible="{Binding !IsDestructive}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
