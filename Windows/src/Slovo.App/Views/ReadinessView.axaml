<!-- The sidebar card that says whether dictation can work (the macOS ReadinessCard): a coloured
     dot, a status and the engine or the fix, and a chevron when a click leads somewhere. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Slovo.App.ViewModels"
             xmlns:c="using:Slovo.App.Controls"
             x:Class="Slovo.App.Views.ReadinessView"
             x:DataType="vm:ReadinessViewModel">
  <UserControl.Styles>
    <Style Selector="Button.Readiness">
      <Setter Property="Background" Value="{DynamicResource Slovo.PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Slovo.PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Slovo.RowRadius}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.Readiness:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Slovo.RowHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Slovo.PanelBorder}" />
    </Style>
    <Style Selector="Button.Readiness:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Slovo.SidebarSelection}" />
    </Style>
    <!-- "Ready" has nothing to open, but it looks the same as the other states. -->
    <Style Selector="Button.Readiness:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Slovo.PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Slovo.PanelBorder}" />
    </Style>
    <Style Selector="Ellipse.Dot">
      <Setter Property="Fill" Value="{DynamicResource Slovo.Accent}" />
    </Style>
    <Style Selector="Ellipse.Dot.Ready">
      <Setter Property="Fill" Value="{DynamicResource Slovo.Success}" />
    </Style>
    <Style Selector="Ellipse.Dot.Warning">
      <Setter Property="Fill" Value="{DynamicResource Slovo.Warning}" />
    </Style>
  </UserControl.Styles>
  <Button Classes="Readiness" Command="{Binding OpenCommand}" IsEnabled="{Binding HasAction}"
          AutomationProperties.Name="{Binding Title}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Ellipse Classes="Dot" Classes.Ready="{Binding IsReady}" Classes.Warning="{Binding IsWarning}"
               Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,8,0" />
      <StackPanel Grid.Column="1" Spacing="1">
        <TextBlock FontSize="11" FontWeight="Medium" Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock Classes="Caption" Text="{Binding Detail}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <c:StrokeIcon Grid.Column="2" Icon="{StaticResource Icon.ChevronRight}" Width="10" Height="10" StrokeWidth="2.6"
                    VerticalAlignment="Top" Margin="6,4,0,0" Foreground="{DynamicResource Slovo.TextSecondary}"
                    IsVisible="{Binding HasAction}" />
    </Grid>
  </Button>
</UserControl>
