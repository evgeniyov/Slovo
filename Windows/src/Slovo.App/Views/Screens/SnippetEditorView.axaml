<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Slovo.App.ViewModels.Screens"
             xmlns:loc="using:Slovo.App.Localization"
             x:Class="Slovo.App.Views.Screens.SnippetEditorView"
             x:DataType="vm:SnippetEditorViewModel"
             Width="480">
  <StackPanel Spacing="10">
    <TextBlock Classes="SectionTitle" Text="{Binding Title}" />
    <TextBlock Classes="SectionLabel" Text="{loc:T snippets.editor.trigger}" Margin="0,4,0,0" />
    <TextBox Text="{Binding Trigger}" />
    <TextBlock Classes="Caption" Text="{loc:T snippets.editor.trigger.hint}" TextWrapping="Wrap" />
    <TextBlock Classes="SectionLabel" Text="{loc:T snippets.editor.text}" Margin="0,6,0,0" />
    <TextBox Text="{Binding Expansion}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="220"
             PlaceholderText="{loc:T snippets.editor.text.placeholder}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Classes="Secondary" Content="{loc:T common.cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Classes="Primary" Content="{loc:T common.save}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
    </StackPanel>
  </StackPanel>
</UserControl>
