<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Slovo.App.ViewModels.Screens"
             xmlns:c="using:Slovo.App.Controls"
             xmlns:loc="using:Slovo.App.Localization"
             x:Class="Slovo.App.Views.Screens.StyleView"
             x:DataType="vm:StyleViewModel">
  <UserControl.Styles>
    <Style Selector="Button.StyleCard">
      <Setter Property="Background" Value="{DynamicResource Slovo.PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Slovo.PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Slovo.CardRadius}" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.StyleCard:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Slovo.RowHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Slovo.PanelBorder}" />
    </Style>
    <Style Selector="Button.StyleCard.Selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Slovo.Accent}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="15" />
    </Style>
    <Style Selector="Button.StyleCard.Selected:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Slovo.Accent}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Spacing="18" Margin="32,28">
      <c:PageHeader Title="{loc:T sidebar.style}" Subtitle="{loc:T style.subtitle}" />
      <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Background="Transparent">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StyleTabItem"><TextBlock Text="{Binding Title}" /></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Spacing="18" IsVisible="{Binding IsCategory}">
        <ItemsControl ItemsSource="{Binding Cards}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StyleCardViewModel">
              <Button Classes="StyleCard" Classes.Selected="{Binding IsSelected}" Margin="0,0,12,0"
                      Command="{Binding $parent[UserControl].((vm:StyleViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="Headline" Text="{Binding Title}" />
                    <c:StrokeIcon Grid.Column="1" Icon="{StaticResource Icon.Check}" Width="14" Height="14" Foreground="{DynamicResource Slovo.AccentText}" IsVisible="{Binding IsSelected}" />
                  </Grid>
                  <TextBlock Classes="Caption" Text="{Binding Detail}" />
                  <Border Classes="Inset" Margin="0,10,0,0">
                    <TextBlock Classes="Sample" Text="{Binding Sample}" />
                  </Border>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="Headline" Text="{loc:T style.apps.title}" />
            <TextBlock Classes="Caption" Text="{loc:T style.apps.detail}" />
            <TextBlock Classes="Secondary" Text="{loc:T style.apps.empty}" IsVisible="{Binding !HasApps}" />
            <ItemsControl ItemsSource="{Binding Apps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AppRowViewModel">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <TextBlock Text="{Binding App.Name}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="Secondary" Content="{loc:T style.apps.move}">
                      <Button.Flyout>
                        <MenuFlyout ItemsSource="{Binding Moves}">
                          <MenuFlyout.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:CategoryMove">
                              <Setter Property="Header" Value="{Binding Title}" />
                              <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:StyleViewModel)DataContext).MoveCommand}" />
                              <Setter Property="CommandParameter" Value="{Binding}" />
                            </ControlTheme>
                          </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Spacing="14" IsVisible="{Binding IsCleanup}">
        <TextBlock Classes="Secondary" Text="{loc:T style.cleanup.message}" />
        <Border Classes="Card">
          <StackPanel Spacing="10">
            <c:SettingsRow Title="{loc:T style.cleanup.fillers}" Detail="{loc:T style.cleanup.fillers.detail}" Padding="0">
              <ToggleSwitch IsChecked="{Binding RemoveFillers}" AutomationProperties.Name="{loc:T style.cleanup.fillers}" />
            </c:SettingsRow>
            <Grid ColumnDefinitions="*,12,*">
              <Border Classes="Inset"><StackPanel Spacing="4"><TextBlock Classes="SectionLabel" Text="{loc:T style.cleanup.before}" /><TextBlock Classes="Sample" Text="{loc:T style.cleanup.fillers.before}" /></StackPanel></Border>
              <Border Grid.Column="2" Classes="Inset"><StackPanel Spacing="4"><TextBlock Classes="SectionLabel" Text="{loc:T style.cleanup.after}" /><TextBlock Classes="Sample" Text="{loc:T style.cleanup.fillers.after}" /></StackPanel></Border>
            </Grid>
          </StackPanel>
        </Border>
        <Border Classes="Card">
          <StackPanel Spacing="10">
            <c:SettingsRow Title="{loc:T style.cleanup.repetitions}" Detail="{loc:T style.cleanup.repetitions.detail}" Padding="0">
              <ToggleSwitch IsChecked="{Binding RemoveRepetitions}" AutomationProperties.Name="{loc:T style.cleanup.repetitions}" />
            </c:SettingsRow>
            <Grid ColumnDefinitions="*,12,*">
              <Border Classes="Inset"><StackPanel Spacing="4"><TextBlock Classes="SectionLabel" Text="{loc:T style.cleanup.before}" /><TextBlock Classes="Sample" Text="{loc:T style.cleanup.repetitions.before}" /></StackPanel></Border>
              <Border Grid.Column="2" Classes="Inset"><StackPanel Spacing="4"><TextBlock Classes="SectionLabel" Text="{loc:T style.cleanup.after}" /><TextBlock Classes="Sample" Text="{loc:T style.cleanup.repetitions.after}" /></StackPanel></Border>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
