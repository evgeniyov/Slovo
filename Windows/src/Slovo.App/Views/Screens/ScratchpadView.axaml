<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Slovo.App.ViewModels.Screens"
             xmlns:c="using:Slovo.App.Controls"
             xmlns:loc="using:Slovo.App.Localization"
             x:Class="Slovo.App.Views.Screens.ScratchpadView"
             x:DataType="vm:ScratchpadViewModel">
  <DockPanel Margin="32,28">
    <c:PageHeader DockPanel.Dock="Top" Title="{loc:T sidebar.scratchpad}" Subtitle="{loc:T scratchpad.subtitle}" Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="Secondary" Command="{Binding ToggleDictationCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:StrokeIcon Icon="{StaticResource Icon.Mic}" Width="13" Height="13" />
            <Panel>
              <TextBlock Text="{loc:T scratchpad.dictate}" IsVisible="{Binding !IsDictating}" />
              <TextBlock Text="{loc:T scratchpad.stopDictation}" IsVisible="{Binding IsDictating}" />
            </Panel>
          </StackPanel>
        </Button>
        <Button Classes="Primary" Command="{Binding NewNoteCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:StrokeIcon Icon="{StaticResource Icon.Plus}" Width="13" Height="13" />
            <TextBlock Text="{loc:T scratchpad.newNote}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </c:PageHeader>

    <c:EmptyState DockPanel.Dock="Top" Icon="{StaticResource Icon.Note}" Title="{loc:T scratchpad.empty.title}" Message="{loc:T scratchpad.empty.message}"
                  ActionText="{loc:T scratchpad.newNote}" ActionCommand="{Binding NewNoteCommand}" IsVisible="{Binding IsEmpty}" VerticalAlignment="Top" />

    <Grid ColumnDefinitions="240,16,*" IsVisible="{Binding !IsEmpty}">
      <Border Classes="List">
        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NoteRowViewModel">
              <StackPanel Spacing="2" Margin="2,4">
                <TextBlock Classes="Medium" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="Caption" Text="{Binding Edited}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Border Grid.Column="2" Classes="List" IsVisible="{Binding HasSelection}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="16,10,8,0">
            <TextBlock Classes="Caption" Text="{Binding SelectedRow.Edited}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="Ghost" Command="{Binding CopyCommand}" ToolTip.Tip="{loc:T home.action.copy}" AutomationProperties.Name="{loc:T home.action.copy}">
              <Panel>
                <c:StrokeIcon Icon="{StaticResource Icon.Copy}" Width="14" Height="14" IsVisible="{Binding !Copied.IsOn}" />
                <c:StrokeIcon Icon="{StaticResource Icon.Check}" Width="14" Height="14" IsVisible="{Binding Copied.IsOn}" Foreground="{DynamicResource Slovo.Success}" />
              </Panel>
            </Button>
            <Button Grid.Column="2" Classes="Ghost" Command="{Binding DeleteCommand}" ToolTip.Tip="{loc:T common.delete}" AutomationProperties.Name="{loc:T common.delete}">
              <c:StrokeIcon Icon="{StaticResource Icon.Trash}" Width="14" Height="14" />
            </Button>
          </Grid>
          <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                   PlaceholderText="{loc:T scratchpad.editorPlaceholder}" Padding="16,8" FontSize="14"
                   VerticalContentAlignment="Top" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
