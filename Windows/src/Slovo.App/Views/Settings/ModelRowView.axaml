<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Slovo.App.ViewModels.Settings"
             xmlns:loc="using:Slovo.App.Localization"
             x:Class="Slovo.App.Views.Settings.ModelRowView"
             x:DataType="vm:ModelRowViewModel">
  <Grid ColumnDefinitions="*,Auto" Margin="0,10">
    <StackPanel Spacing="3" Margin="0,0,16,0">
      <WrapPanel ItemSpacing="8" LineSpacing="4">
        <TextBlock Classes="Medium" Text="{Binding Name}" VerticalAlignment="Center" />
        <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource Slovo.AccentSoft}" IsVisible="{Binding IsRecommended}">
          <TextBlock FontSize="11" Foreground="{DynamicResource Slovo.AccentText}" Text="{Binding Recommended}" />
        </Border>
        <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource Slovo.SuccessSoft}" IsVisible="{Binding IsReady}">
          <TextBlock FontSize="11" Foreground="{DynamicResource Slovo.Success}" Text="{Binding StatusText}" />
        </Border>
        <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource Slovo.DestructiveSoft}" IsVisible="{Binding IsDamaged}">
          <TextBlock FontSize="11" Foreground="{DynamicResource Slovo.Destructive}" Text="{Binding StatusText}" />
        </Border>
        <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource Slovo.InsetBackground}">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!IsReady" />
              <Binding Path="!IsDamaged" />
            </MultiBinding>
          </Border.IsVisible>
          <TextBlock FontSize="11" Foreground="{DynamicResource Slovo.TextSecondary}" Text="{Binding StatusText}" />
        </Border>
        <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource Slovo.AccentSoft}" IsVisible="{Binding IsLoading}">
          <TextBlock FontSize="11" Foreground="{DynamicResource Slovo.AccentText}" Text="{loc:T engine.status.loading}" />
        </Border>
      </WrapPanel>
      <TextBlock Classes="Caption" Text="{Binding Tradeoff}" TextWrapping="Wrap" />
      <TextBlock Classes="Caption" Text="{Binding SizeText}" IsVisible="{Binding SizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="Caption" Foreground="{DynamicResource Slovo.Destructive}" Text="{Binding DamagedReason}" IsVisible="{Binding DamagedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
      <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsDownloading}" Margin="0,4,0,0" />
      <TextBlock Classes="Caption" Foreground="{DynamicResource Slovo.Destructive}" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
    </StackPanel>
    <!-- A load reads the model files; the actions wait for it and say why on hover. -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Background="Transparent"
                ToolTip.Tip="{Binding BusyText}">
      <Button Classes="Primary" Content="{Binding DownloadText}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" />
      <Button Classes="Secondary" Content="{loc:T common.cancel}" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}" />
      <Button Classes="Ghost" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" ToolTip.Tip="{loc:T common.delete}" AutomationProperties.Name="{loc:T common.delete}">
        <TextBlock Text="{loc:T common.delete}" Foreground="{DynamicResource Slovo.Destructive}" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
