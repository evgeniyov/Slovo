<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Slovo.App.ViewModels.Settings"
             xmlns:v="using:Slovo.App.Views"
             xmlns:loc="using:Slovo.App.Localization"
             x:Class="Slovo.App.Views.Settings.AboutSettingsView"
             x:DataType="vm:AboutSettingsViewModel">
  <StackPanel Spacing="22">
    <StackPanel Orientation="Horizontal" Spacing="14">
      <v:AppLogo Width="56" Height="56" />
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="Logo" FontSize="24" Text="Slovo" />
        <TextBlock Classes="Secondary" Text="{loc:T settings.about.tagline}" />
        <TextBlock Classes="Caption" Text="{Binding VersionText}" />
      </StackPanel>
    </StackPanel>
    <StackPanel Spacing="8">
      <TextBlock Classes="SectionLabel" Text="{loc:T settings.about.licenses}" />
      <Border Classes="Card" Padding="16,8">
        <ItemsControl ItemsSource="{Binding Licenses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LicenseLine">
              <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                <StackPanel Spacing="2">
                  <TextBlock Classes="Medium" Text="{Binding Name}" />
                  <TextBlock Classes="Caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="Caption" Text="{Binding License}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <Button Classes="Link" Content="{loc:T help.openModels}" Command="{Binding OpenModelsFolderCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
