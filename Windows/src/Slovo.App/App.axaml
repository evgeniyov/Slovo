<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Slovo.App"
             x:Class="Slovo.App.App"
             Name="Slovo"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Slovo/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://Slovo/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Slovo/Themes/Styles.axaml" />
    <StyleInclude Source="avares://Slovo/Themes/SettingsStyles.axaml" />
    <StyleInclude Source="avares://Slovo/Themes/Components.axaml" />
  </Application.Styles>
</Application>
