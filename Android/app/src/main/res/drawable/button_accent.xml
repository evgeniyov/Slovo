<?xml version="1.0" encoding="utf-8"?>
<!-- The one bright thing on the screen. The ripple is dark because it falls on the
     accent fill, where a white ripple would be invisible. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_dark">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</ripple>
