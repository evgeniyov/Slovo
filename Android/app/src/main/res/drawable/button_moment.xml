<?xml version="1.0" encoding="utf-8"?>
<!-- Tapped many times during a meeting, so it is large and outlined rather than filled:
     the filled red stop button below it has to stay the loudest thing on the screen. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_light">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</ripple>
